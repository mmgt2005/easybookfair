# Copy to .env.local and fill in from your Supabase project settings.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose to the browser. Used by webhook handlers and
# trusted server-side jobs (lib/supabase/service.ts) that must bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — the platform's own account (test mode keys start with sk_test_/
# whsec_test_), never a connected account's. STRIPE_SECRET_KEY from
# Developers > API keys; STRIPE_WEBHOOK_SECRET from the specific webhook
# endpoint you create in Developers > Webhooks pointing at
# <your-deployment-url>/api/webhooks/stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Public — safe to expose to the browser (it can only create PaymentIntents
# server-side already created for it, not charge arbitrary amounts). Same
# Developers > API keys page as STRIPE_SECRET_KEY. Needed by the public
# storefront/wallet-funding pages, which use Stripe.js (Elements) directly
# in the browser — a separate integration from the admin checkout screen's
# Terminal SDK.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend — order confirmation and wallet-funding confirmation emails
# (lib/email.ts). RESEND_API_KEY from resend.com/api-keys. EMAIL_FROM must
# be an address on a domain you've verified in Resend (a shared test
# domain works for local dev, but real delivery needs your own verified
# sending domain). Sending is best-effort — a failure here never fails the
# underlying payment.
RESEND_API_KEY=
EMAIL_FROM=

# Absolute base URL used to build links inside emails and QR codes sent
# from Server Actions/Components (no browser origin available there) —
# e.g. the fair-approval email's link to /org, and the org marketing
# toolkit's storefront QR code. Optional: falls back to Vercel's stable
# production URL (VERCEL_PROJECT_PRODUCTION_URL), then the current
# deployment's own URL (VERCEL_URL), then http://localhost:3000. Strongly
# recommended to set explicitly once you have a real domain — VERCEL_URL
# in particular is the current deployment's unique URL, which Vercel's
# Deployment Protection can put behind a login wall even in production,
# so a QR code or email link built from it (if the other fallbacks aren't
# available) can send people to a Vercel login page instead of your site.
NEXT_PUBLIC_SITE_URL=

# Cloudflare Turnstile — bot-check widget on the public no-login forms
# (org signup, author submission, guest checkout, wallet/pool donations;
# lib/turnstile.ts, lib/spamGuard.ts). Get both from a free Turnstile
# site at dash.cloudflare.com/?to=/:account/turnstile. Optional: if
# TURNSTILE_SECRET_KEY is unset, verification is skipped (fails open) —
# same "degrades gracefully when unconfigured" pattern as RESEND_API_KEY
# — so local dev works without a real Cloudflare account. The disposable-
# email blocklist and honeypot field layers still apply either way.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ShipEngine — real shipping-rate estimates for a fair's allocated
# inventory (lib/shippingRates.ts, the "Shipping cost estimate" card on
# the admin allocations screen). Optional: if SHIPENGINE_API_KEY or
# SHIPENGINE_CARRIER_ID is unset, the feature disables itself with an
# explanatory message instead of erroring — same "degrades gracefully
# when unconfigured" pattern as RESEND_API_KEY/TURNSTILE_SECRET_KEY. Get a
# free developer account at shipengine.com/signup/ (no credit card
# required); USPS rates are available immediately, no separate USPS
# account needed. SHIPENGINE_CARRIER_ID is the ShipEngine-assigned id of
# your connected USPS carrier account — a one-time value from your
# ShipEngine dashboard (Carrier Settings), not derived from a shipment.
# This app only ever calls the rate-estimate endpoint — no label is ever
# purchased here. The SHIPPING_ORIGIN_* fields describe this app's single
# warehouse/staging address — one physical location for the whole
# platform, not per-org or per-fair — used as the "ship from" side of
# every estimate; the "ship to" side is read from each org's own shipping
# address (set on /org/staff or an admin's organization edit page).
# ShipEngine's rate-estimate endpoint requires a full city/state/postal/
# country on both ends, so SHIPPING_ORIGIN_ZIP, _CITY, and _STATE are all
# required (unlike this app's previous EasyPost integration, which only
# needed a ZIP); _NAME/_STREET1 are unused by rate estimates but kept for
# labeling if this app ever buys a real label here in the future.
SHIPENGINE_API_KEY=
SHIPENGINE_CARRIER_ID=
SHIPPING_ORIGIN_NAME=
SHIPPING_ORIGIN_STREET1=
SHIPPING_ORIGIN_CITY=
SHIPPING_ORIGIN_STATE=
SHIPPING_ORIGIN_ZIP=
SHIPPING_ORIGIN_COUNTRY=US

# Secret Vercel Cron sends as `Authorization: Bearer $CRON_SECRET` when it
# calls /api/cron/transition-fairs (see vercel.json) — the daily job that
# moves an 'active' fair to 'return_window' the day after its end date.
# Any random string works; generate one with e.g. `openssl rand -hex 32`.
# Must be set in Vercel's project settings too, not just locally, or the
# cron job gets a 401 every day and never runs.
CRON_SECRET=
