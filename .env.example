# Copy to .env.local and fill in from your Supabase project settings.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose to the browser. Used by webhook handlers and
# trusted server-side jobs (lib/supabase/service.ts) that must bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — the platform's own account (test mode keys start with sk_test_/
# whsec_test_), never a connected account's. STRIPE_SECRET_KEY from
# Developers > API keys; STRIPE_WEBHOOK_SECRET from the specific webhook
# endpoint you create in Developers > Webhooks pointing at
# <your-deployment-url>/api/webhooks/stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
